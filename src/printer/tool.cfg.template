# This file contains common pin mappings for a BIGTREETECH EBBT@@N@@
# Canbus board. To use this config, the firmware should be compiled for the
# STM32G0B1 with "8 MHz crystal" and "USB (on PA11/PA12)" or "CAN bus (on PB0/PB1)".
# The "EBB Can" micro-controller will be used to control the components on the nozzle.
#
# Generated by Tool Feeder's installer for tool @@N@@. CHANGE_ME_* values are
# unique to this physical tool/dock and can't be auto-generated — fill them
# in before use. Everything else follows the same EBBT-board pinout as every
# other tool.

# See docs/Config_Reference.md for a description of parameters.

[mcu EBBT@@N@@]
canbus_uuid: CHANGE_ME_t@@N@@_canbus_uuid
# python3 ~/katapult/scripts/flashtool.py -i can0 -u <uuid> -r
# python3 ~/katapult/scripts/flashtool.py -i can0 -u <uuid> -f ~/klipper/out/klipper.bin

[adxl345 T@@N@@]
cs_pin: EBBT@@N@@: PB12
spi_software_sclk_pin: EBBT@@N@@: PB10
spi_software_mosi_pin: EBBT@@N@@: PB11
spi_software_miso_pin: EBBT@@N@@: PB2
axes_map: x,z,-y

[extruder@@N_SUFFIX@@]
step_pin: EBBT@@N@@: PD0
dir_pin: !EBBT@@N@@: PD1
enable_pin: !EBBT@@N@@: PD2
heater_pin: EBBT@@N@@: PB13
sensor_pin: EBBT@@N@@: PA3
sensor_type: ATC Semitec 104NT-4-R025H42G
rotation_distance: 22.319100012672
gear_ratio: 50:10,
microsteps: 16
full_steps_per_rotation: 200
max_extrude_only_distance: 1400.0
max_extrude_only_velocity: 75.0
max_extrude_only_accel: 1500
nozzle_diameter: 0.400
filament_diameter: 1.750
max_extrude_cross_section: 0.64

control: pid
pid_Kp: 39.661
pid_Ki: 4.407
pid_Kd: 89.238

min_temp: -10
max_temp: 300
min_extrude_temp: 170
pressure_advance: 0.04                                               # See tuning pressure advance doc
pressure_advance_smooth_time: 0.066


[tmc2209 extruder@@N_SUFFIX@@]
uart_pin: EBBT@@N@@: PA15
run_current: 0.45
hold_current: 0.1
driver_TPOWERDOWN: 20
stealthchop_threshold: 999999

[heater_fan T@@N@@_hotend_fan]
pin: EBBT@@N@@: PA0
heater: extruder@@N_SUFFIX@@
heater_temp: 50.0
kick_start_time: 0.5

[fan_generic T@@N@@_partfan]
pin: EBBT@@N@@: PA1
kick_start_time: 0.25
cycle_time: 0.15
off_below: 0.10

[gcode_macro T@@N@@]
variable_active: 0
variable_color: ""
variable_spool_id: None
gcode:
    _TOOL_ROUTER TR=@@N@@

[tool T@@N@@]
tool_number: @@N@@
detection_pin: !EBBT@@N@@:PB6
gcode_x_offset: 0
gcode_y_offset: 0
gcode_z_offset: 0
extruder: extruder@@N_SUFFIX@@
fan: T@@N@@_partfan
# These are build-specific — where this tool sits in its dock.
params_park_x: CHANGE_ME_t@@N@@_park_x
params_park_y: CHANGE_ME_t@@N@@_park_y
params_park_z: CHANGE_ME_t@@N@@_park_z
# Run Input Shaper per tool and enter the frequency here.
params_input_shaper_type_x: 'mzv'
params_input_shaper_freq_x: CHANGE_ME_t@@N@@_shaper_freq_x
params_input_shaper_damping_ratio_x: CHANGE_ME_t@@N@@_shaper_damping_x
params_input_shaper_type_y: 'mzv'
params_input_shaper_freq_y: CHANGE_ME_t@@N@@_shaper_freq_y
params_input_shaper_damping_ratio_y: CHANGE_ME_t@@N@@_shaper_damping_y

# [neopixel T@@N@@_leds]
# pin: EBBT@@N@@:PD3
# chain_count: 3
# color_order: GRB
# initial_RED: 1.0
# initial_GREEN: 0.0
# initial_BLUE: 0.0
# initial_WHITE: 0.0

[gcode_macro _T@@N@@_vars]
variable_logo_led_name:         "T@@N@@_leds"
variable_logo_idx:              "1"
variable_nozzle_led_name:       "T@@N@@_leds"
variable_nozzle_idx:            "2,3"
gcode:


[filament_switch_sensor filament_sensor_T@@N@@]
switch_pin: CHANGE_ME_t@@N@@_filament_sensor_pin
pause_on_runout: FALSE
runout_gcode:
  SET_TOOL_FILAMENT_STATUS T=@@N@@ HAS_FILAMENT=0
  M118 Runout sensor T@@N@@ reports: Runout
insert_gcode:
  SET_TOOL_FILAMENT_STATUS T=@@N@@ HAS_FILAMENT=1
  M118 Runout sensor T@@N@@ reports: Filament Detected
  LOAD_ANY_TOOL T=@@N@@ S=30 D=1400  # 1400mm is a reasonable default Bowden length — adjust to match your tube

[filament_motion_sensor encoder_sensor_T@@N@@]
switch_pin: CHANGE_ME_t@@N@@_encoder_sensor_pin
detection_length: 10
extruder: extruder@@N_SUFFIX@@
pause_on_runout: False
runout_gcode:
  {% if printer.print_stats.state == "printing" and not printer.pause_resume.is_paused %}
    PAUSE
    M117 Filament encoder runout
  {% endif %}
insert_gcode:
  M117 Filament encoder inserted

[filament_switch_sensor filament_sensor_at_T@@N@@]
switch_pin: ^EBBT@@N@@:PB8
pause_on_runout: FALSE
runout_gcode:
  M118 Runout sensor at T@@N@@ reports: No filament Detected
insert_gcode:
  M118 Runout sensor at T@@N@@ reports: Filament Detected
