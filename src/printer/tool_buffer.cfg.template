# Defaults to two-sensor mode (recommended — adds jam detection). If your
# hardware only has one sensor (e.g. Belay-style wiring), comment out the
# active [feeder_buffer T@@N@@] block below and uncomment the
# single-sensor one beneath it — only one may be active at a time, since
# both use the same section name.

[feeder_buffer T@@N@@]
sensor_mode: dual
advance_pin: CHANGE_ME_t@@N@@_advance_pin
trailing_pin: CHANGE_ME_t@@N@@_trailing_pin
extruder_stepper: _tool@@N@@_feeder
multiplier_high: 1.05
multiplier_low: 0.95
filament_error_sensitivity: 5
# Prints "Buffer T@@N@@: neutral -> advancing" etc. to the console on every
# state change, so you can confirm the sensors are triggering. Set to False
# once you've verified it's working, to quiet the console during prints.
debug_console: True

# ---- Single-sensor alternative (Belay-wiring-compatible) — swap in by ----
# ---- commenting out the block above and uncommenting this one: ----------
#
# [feeder_buffer T@@N@@]
# sensor_mode: single
# sensor_pin: CHANGE_ME_t@@N@@_sensor_pin
# extruder_stepper: _tool@@N@@_feeder
# multiplier_high: 1.05
# multiplier_low: 0.95
# debug_console: True
